pipeline {
  agent any
  environment {
    DOCKERHUB_CRED = credentials('dockerhub-token') 
    EC2_SSH = credentials('')           
    SONAR_TOKEN = credentials('sonar-token')
    DOCKERHUB_USER = 'sudhir'
    EC2_USER = 'ec2-user'
    EC2_HOST = '<EC2-PUBLIC-IP>'                  
  }
  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Unit Tests') {
      steps {
        sh 'pytest --maxfail=1 --disable-warnings -q || true'
        junit '**/test-results/*.xml' // if pytest configured to produce junit xml
      }
    }

    stage('Code Quality') {
      steps {
        sh "sonar-scanner -Dsonar.projectKey=ACEest_Fitness -Dsonar.login=${SONAR_TOKEN}"
      }
    }

    stage('Build Docker Image') {
      steps {
        script {
          def tag = "${DOCKERHUB_USER}/aceest_fitness:${env.BUILD_ID}"
          sh "docker build -t ${tag} ."
          sh "docker tag ${tag} ${DOCKERHUB_USER}/aceest_fitness:latest"
        }
      }
    }

    stage('Push to DockerHub') {
      steps {
        sh "echo ${DOCKERHUB_CRED_PSW} | docker login -u ${DOCKERHUB_CRED_USR} --password-stdin"
        sh "docker push ${DOCKERHUB_USER}/aceest_fitness:${env.BUILD_ID}"
        sh "docker push ${DOCKERHUB_USER}/aceest_fitness:latest"
      }
    }

    stage('Deploy to EC2') {
      steps {
        sshagent (credentials: ['ec2-ssh-key']) {
          sh """
            ssh -o StrictHostKeyChecking=no ${EC2_USER}@${EC2_HOST} '
              docker pull ${DOCKERHUB_USER}/aceest_fitness:latest &&
              docker stop aceest_app || true &&
              docker rm aceest_app || true &&
              docker run -d --name aceest_app -p 5000:5000 ${DOCKERHUB_USER}/aceest_fitness:latest
            '
          """
        }
      }
    }

    stage('Smoke Test') {
      steps {
        sh "curl -s -o /dev/null -w \"%{http_code}\" http://${EC2_HOST}:5000 | grep 200"
      }
    }
  }

  post {
    success { echo 'Pipeline completed successfully.' }
    failure { echo 'Pipeline failed — check console output.' }
  }
}
